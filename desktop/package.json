{
  "name": "risk-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "نسخه ویندوزی سامانه پیشنهادات ارزیابی ریسک",
  "main": "main.cjs",
  "author": "Risk Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.company.risk.suggestions",
    "productName": "RiskSuggestions",
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "settings.html",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "سامانه ارزیابی ریسک"
    },
    "portable": {
      "artifactName": "RiskSuggestions-Portable-${version}.exe"
    }
  }
}
